{
  "interface_version": 2,
  "name": "horizonWalkerAutoProject",
  "label": "地平线行者 自动化",
  "version": "0.0.1",
  "github": "https://github.com/haneruByte/MFAAHorizonWalker",
  "welcome": "## 2026/01/24 新增功能:活动日常任务",
  "controller": [
    {
      "name": "Android",
      "label": "Android",
      "type": "Adb"
    }
  ],
  "resource": [
    {
      "name": "Default",
      "label": "默认资源",
      "path": [
        "resource"
      ],
      "controller": [
        "Android"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "enter_startApp",
      "default_check": true
    },
    {
      "name": "收菜",
      "entry": "farm_tribute1",
      "default_check": true
    },
    {
      "name": "讨伐",
      "entry": "hunt_guanQiaClick",
      "default_check": true,
      "option": [
        "讨伐目标"
      ]
    },
    {
      "name": "裂缝探索",
      "entry": "weekly_guanQiaClick",
      "default_check": true
    },
    {
      "name": "愿望",
      "entry": "wish_guanQiaClick",
      "default_check": true,
      "option": [
        "愿望目标"
      ]
    },
    {
      "name": "商店",
      "entry": "shop_shopCheck",
      "default_check": true,
      "option": [
        "购买礼物",
        "购买B级契约券",
        "购买A级契约券",
        "购买S级契约券"
      ]
    },
    {
      "name": "日常任务",
      "entry": "daily_listClick",
      "default_check": true
    },
    {
      "name": "活动日常任务",
      "entry": "event_eventClick",
      "default_check": true
    },
    {
      "name": "收件箱",
      "entry": "mail_mailBoxClick",
      "default_check": true
    }
  ],
