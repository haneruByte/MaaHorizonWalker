{
  "interface_version": 2,
  "name": "MaaHorizonWalker",
  "label": "地平线行者 自动化",
  "version": "v0.1.0",
  "github": "https://github.com/haneruByte/MaaHorizonWalker",
  "welcome": "## v0.1.0 首次公开：进入游戏、收菜、讨伐、裂缝探索、商店、日常、活动本、主线、愿望、活动日常、收件箱",
  "controller": [
    {
      "name": "Android",
      "label": "Android",
      "type": "Adb"
    }
  ],
  "resource": [
    {
      "name": "Default",
      "label": "默认资源",
      "path": [
        "resource"
      ],
      "controller": [
        "Android"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "enter_bootHub",
      "default_check": true
    },
    {
      "name": "收菜",
      "entry": "homeGate_check1",
      "default_check": true,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "farm_tribute1"
          ]
        }
      }
    },
    {
      "name": "讨伐",
      "entry": "homeGate_check1",
      "default_check": true,
      "option": [
        "讨伐目标"
      ],
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "hunt_guanQiaClick"
          ]
        }
      }
    },
    {
      "name": "裂缝探索",
      "entry": "homeGate_check1",
      "default_check": true,
      "option": [
        "裂缝探索层数"
      ],
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "weekly_guanQiaClick"
          ]
        }
      }
    },
    {
      "name": "愿望",
      "entry": "homeGate_check1",
      "default_check": true,
      "option": [
        "愿望目标"
      ],
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "wish_guanQiaClick"
          ]
        }
      }
    },
    {
      "name": "每日活动本",
      "entry": "homeGate_check1",
      "default_check": true,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "story_eventClick"
          ]
        }
      }
    },
    {
      "name": "商店",
      "entry": "homeGate_check1",
      "default_check": true,
      "option": [
        "购买礼物",
        "购买B级契约券",
        "购买A级契约券",
        "购买S级契约券"
      ],
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "shop_shopCheck"
          ]
        }
      }
    },
    {
      "name": "活动日常任务",
      "entry": "homeGate_check1",
      "default_check": true,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "event_eventClick"
          ]
        }
      }
    },
    {
      "name": "日常任务",
      "entry": "homeGate_check1",
      "default_check": true,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "daily_listClick"
          ]
        }
      }
    },
    {
      "name": "收件箱",
      "entry": "homeGate_check1",
      "default_check": true,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "mail_mailBoxClick"
          ]
        }
      }
    },
    {
      "name": "主线自动推进",
      "entry": "homeGate_check1",
      "default_check": false,
      "pipeline_override": {
        "homeGate_pass": {
          "next": [
            "main_guanQiaClick"
          ]
        }
      }
    }
  ],
